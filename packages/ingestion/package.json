{
  "name": "@auditreq/ingestion",
  "version": "0.1.0",
  "description": "Ingestion des données ouvertes et récolte automatisée du Registraire des entreprises du Québec",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "ingerer": "npm run build && node dist/cli.js",
    "agent:worker": "npm run build && node dist/agent/worker.js",
    "download:open": "npm run build && node dist/download-open-data.js"
  },
  "dependencies": {
    "@auditreq/core": "*",
    "openai": "^4.86.1",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
